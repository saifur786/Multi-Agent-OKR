rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Hardened Primitives
    // ------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && isVerifiedEmail();
    }

    function isAllowedGeminiModel(model) {
      return model is string && model in [
        'gemini-4-hydrogen',
        'gemini-4-argon',
        'gemini-4-carbon',
        'gemini-3.1-flash-lite'
      ];
    }

    // ------------------------------------------------------------------
    // Validation Blueprints ("Anti-Update-Gap")
    // ------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidUserPreference(data, userId) {
      return data.keys().hasAll(['ownerUid', 'navButtonOrder', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'navButtonOrder', 'preferredIndustry', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.navButtonOrder is list
        && data.navButtonOrder.size() >= 1
        && data.navButtonOrder.size() <= 12
        && data.navButtonOrder[0] is string
        && data.navButtonOrder[0].size() <= 40
        && (!data.keys().hasAny(['preferredIndustry']) || (data.preferredIndustry is string && data.preferredIndustry.size() >= 1 && data.preferredIndustry.size() <= 80))
        && data.updatedAt is timestamp;
    }

    function isValidUserIndustrySnapshot(data, userId, industryId) {
      return data.keys().hasAll(['ownerUid', 'industryId', 'industryName', 'knowledgeBase', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'industryId', 'industryName', 'knowledgeBase', 'organisationalPrerequisites', 'updatedAt'])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.industryId is string && data.industryId == industryId && isValidId(data.industryId) && data.industryId.size() <= 64
        && data.industryName is string && data.industryName.size() >= 1 && data.industryName.size() <= 120
        && data.knowledgeBase is list
        && data.knowledgeBase.size() >= 1
        && data.knowledgeBase.size() <= 5
        && data.knowledgeBase[0] is map
        && (
          !data.keys().hasAny(['organisationalPrerequisites']) || (
            data.organisationalPrerequisites is list
            && data.organisationalPrerequisites.size() <= 40
            && (data.organisationalPrerequisites.size() == 0 || data.organisationalPrerequisites[0] is map)
          )
        )
        && data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId) {
      return data.keys().hasAll([
          'ownerUid',
          'title',
          'model',
          'rolePresetId',
          'systemInstruction',
          'messageCount',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'title',
          'model',
          'rolePresetId',
          'systemInstruction',
          'industryContext',
          'messageCount',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isAllowedGeminiModel(data.model)
        && data.rolePresetId is string && data.rolePresetId.size() >= 1 && data.rolePresetId.size() <= 64
        && data.systemInstruction is string && data.systemInstruction.size() >= 1 && data.systemInstruction.size() <= 2000
        && (!data.keys().hasAny(['industryContext']) || (data.industryContext is string && data.industryContext.size() >= 1 && data.industryContext.size() <= 80))
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, chatId) {
      return data.keys().hasAll(['ownerUid', 'sessionId', 'role', 'text', 'model', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'sessionId', 'role', 'text', 'model', 'createdAt'])
        && data.ownerUid is string && data.ownerUid == userId && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.sessionId is string && data.sessionId == chatId && isValidId(data.sessionId)
        && data.role is string && data.role in ['user', 'model']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 16000
        && isAllowedGeminiModel(data.model)
        && data.createdAt is timestamp;
    }

    // ------------------------------------------------------------------
    // Owner-Scoped User Collections
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'lastLoginAt']);

      allow delete: if isVerifiedOwner(userId);

      // Workspace Navigation Preferences
      match /preferences/{prefId} {
        allow get: if isOwner(userId) && isValidId(prefId);
        allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(prefId)
          && isValidUserPreference(incoming(), userId)
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(prefId)
          && isValidUserPreference(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['navButtonOrder', 'preferredIndustry', 'updatedAt']);

        allow delete: if isVerifiedOwner(userId) && isValidId(prefId);
      }

      // User Industry Knowledge Base Snapshots
      match /industries/{industryId} {
        allow get: if isOwner(userId) && isValidId(industryId);
        allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(industryId)
          && isValidUserIndustrySnapshot(incoming(), userId, industryId)
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(industryId)
          && isValidUserIndustrySnapshot(incoming(), userId, industryId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().industryId == existing().industryId
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['industryName', 'knowledgeBase', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['industryName', 'knowledgeBase', 'organisationalPrerequisites', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['industryName', 'organisationalPrerequisites', 'updatedAt'])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(industryId);
      }

      // Multi-Turn Gemini Chat Sessions
      match /chats/{chatId} {
        allow get: if isOwner(userId) && isValidId(chatId);
        allow list: if isOwner(userId) && existing().ownerUid == request.auth.uid;

        allow create: if isVerifiedOwner(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming(), userId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'model', 'rolePresetId', 'systemInstruction', 'industryContext', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messageCount', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt'])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(chatId);

        // Ordered Multi-Turn Messages Subcollection
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(chatId) && existing().ownerUid == request.auth.uid;

          allow create: if isVerifiedOwner(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && isValidChatMessage(incoming(), userId, chatId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(userId)/chats/$(chatId));

          allow update: if false;
          allow delete: if isVerifiedOwner(userId) && isValidId(chatId) && isValidId(messageId);
        }
      }
    }
  }
}
